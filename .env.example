# Deployed Vercel functions use project OIDC for AI Gateway. Local runs can use
# a development OIDC token from the CLI or an API key. With neither, policy rules run alone.
AI_GATEWAY_API_KEY=

# Set independent secrets for signed sessions, the demo reset and the cache webhook on Vercel.
SESSION_SECRET=
DEMO_RESET_CODE=
REVALIDATE_SECRET=

# Where Apex's systems of record live (the separately deployed mock), and the service token it expects.
APEX_SYSTEMS_URL=
APEX_SYSTEMS_TOKEN=
# Optional: primary model for the assessment. Fallbacks are set in lib/assessment.ts.
ASSESSMENT_MODEL=
