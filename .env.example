# Set in Vercel to enable a live, schema-validated AI Gateway assessment.
# Without this key, the public POC intentionally uses the same validated fixture response.
AI_GATEWAY_API_KEY=

# Where Apex's systems of record live (the separately deployed mock), and the service token it expects.
APEX_SYSTEMS_URL=
APEX_SYSTEMS_TOKEN=
# Optional: primary model for the assessment. Fallbacks are set in lib/assessment.ts.
ASSESSMENT_MODEL=
